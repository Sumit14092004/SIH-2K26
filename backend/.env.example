# MQTT Broker Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883

# InfluxDB 2.7 Time-Series Storage Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=sih_super_secret_admin_token_2026
INFLUXDB_ORG=sih_team
INFLUXDB_BUCKET=sensor_data

# Twilio SMS Alert Configuration (Get from https://console.twilio.com)
